{
  "name": "event-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "build:static": "STATIC_EXPORT=true next build --webpack",
    "cap:init": "pnpm build:static && cap add ios && cap add android && pnpm cap:assets",
    "cap:sync": "pnpm build:static && cap sync",
    "cap:assets": "capacitor-assets generate",
    "cap:ios": "pnpm build:static && cap sync ios && cap open ios",
    "cap:android": "pnpm build:static && cap sync android && cap open android",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "announcements:setup-notion": "tsx scripts/setup-notion-announcements.ts",
    "push:test": "tsx scripts/send-test-push.ts",
    "otp:test": "tsx scripts/test-otp-input.ts",
    "proof:test": "tsx scripts/test-ticket-proof.ts",
    "proof:demo-link": "tsx scripts/make-demo-proof.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.1",
    "@capacitor/cli": "^8.0.1",
    "@capacitor/core": "^8.0.1",
    "@capacitor/ios": "^8.0.1",
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "@meerkat-events/react": "^0.1.0",
    "@netlify/functions": "^5.3.0",
    "@serwist/next": "^9.5.11",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.106.2",
    "classnames": "^2.5.1",
    "dexie": "^4.2.1",
    "framer-motion": "12.0.0-alpha.1",
    "lib": "workspace:*",
    "lucide-react": "^1.17.0",
    "next": "16.1.1",
    "panzoom": "^9.4.3",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "sass": "^1.44.0",
    "sharp": "^0.33.5",
    "sonner": "^1.7.0",
    "swr": "^2.3.6",
    "viem": "^2.55.19",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "serwist": "^9.5.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
