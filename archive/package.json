{
  "name": "archive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-sw.mjs && next dev",
    "build": "pnpm typecheck:sw && node scripts/build-sw.mjs && next build",
    "typecheck:sw": "tsc --noEmit --strict --skipLibCheck --isolatedModules --target es2022 --lib webworker,es2022 --module esnext --moduleResolution bundler src/sw/ipfs-sw.ts",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@helia/fallback-router": "1.1.2",
    "@helia/http": "4.0.8",
    "@helia/verified-fetch": "8.1.2",
    "@heroicons/react": "^2.1.5",
    "@socialgouv/matomo-next": "^1.11.0",
    "@tanstack/react-query": "^5.66.9",
    "@tanstack/react-query-devtools": "^5.66.9",
    "dayjs": "^1.11.12",
    "helia": "7.1.16",
    "hls.js": "1.7.4",
    "lib": "workspace:*",
    "next": "15.3.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-slick": "^0.30.3",
    "react-use-gesture": "^9.1.3",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/typography": "^0.5.13",
    "@tanstack/eslint-plugin-query": "^5.66.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-slick": "^0.23.13",
    "esbuild": "0.28.2",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "postcss": "^8",
    "sass": "1.44.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
